#!/bin/bash
set -exo pipefail

python -c 'import sys; assert sys.version_info[:2] == (3, 12), f"Python 3.12 is required, got {sys.version}"'
grep -q '^version=9.1.0$' /usr/local/Ascend/ascend-toolkit/latest/aarch64-linux/ascend_toolkit_install.info
test "$(uname -m)" = aarch64
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "${SCRIPT_DIR}/.." && pwd)
python "${REPO_ROOT}/scripts/check_patch_manifest.py"
pip install --upgrade pip packaging setuptools==80.10.2
DEPS_ROOT=${SLIME_ASCEND_DEPS_ROOT:-"$(dirname "${REPO_ROOT}")"}

# Pinned to the CANN 9.1.0 / Python 3.12 A3 aarch64 image.
source /usr/local/Ascend/ascend-toolkit/set_env.sh
source /usr/local/Ascend/nnal/atb/set_env.sh
cd "${DEPS_ROOT}"

echo "0. install PyTorch and torch_npu"
pip install torch==2.10.0 torchvision==0.25.0 \
    --index-url https://download.pytorch.org/whl/cpu
pip install torch_npu==2.10.0.post6 \
    --extra-index-url https://ascend.devcloud.huaweicloud.com/pypi/simple/

echo "1. install SGLang from source"
for a in 1 2 3 4 5; do if [ -d /home/c00954327/sglang ]; then if git -C /home/c00954327/sglang rev-parse -q --verify HEAD; then echo SKIP_CLONE_sglang; git -C /home/c00954327/sglang am --abort 2>/dev/null || true; git -C /home/c00954327/sglang reset --hard; git -C /home/c00954327/sglang clean -fd; break; fi; rm -rf /home/c00954327/sglang; fi; if git clone --depth 1 --branch v0.5.21 https://github.com/sgl-project/sglang.git; then break; fi; echo RETRY_CLONE_sglang; sleep 20; done
cd sglang
git checkout v0.5.21
test "$(git rev-parse HEAD)" = e00930c5489053f26d86b179cee0d087f846acbb
for patch in sglang.patch sglang-top_p.patch sglang-release_hicache.patch sglang-pull_weights.patch sglang-deterministic.patch; do
    git apply "${REPO_ROOT}/patches/third_party/sglang/${patch}"
done
git add -A
git -c user.name=slime-sync -c user.email=slime-sync@localhost commit -m 'Apply Slime v0.5.21 SGLang integration patches'
git am "${REPO_ROOT}/patches/third_party/sglang/0001-v0.5.21-tms-forward-graph-args.patch"
mv python/pyproject.toml python/pyproject.toml.backup
mv python/pyproject_npu.toml python/pyproject.toml
# SGLang v0.5.21 imports transformers.image_processing_backends (5.12.1).
grep -q '"transformers==5.12.1"' python/pyproject.toml
pip install -e python[all_npu]
cd ..

echo "2. install torch & torch_npu & other basic packages"
pip install pybind11==3.0.3 transformers==5.12.1 \
    triton-ascend==3.2.1
pip install \
    https://obs-memfabric-hybrid.obs.cn-north-4.myhuaweicloud.com/mf/v1.3.1/20261114.3/memfabric_hybrid-1.3.1-cp312-cp312-manylinux_2_26_aarch64.manylinux_2_28_aarch64.whl \
    memfabric-zbal==1.1.3
pip install sglang-router==0.3.2 --force-reinstall
python -c "import sglang_router"

echo "3. install CANN 9.1 / Python 3.12 A3 aarch64 prebuilt kernel wheels"
cd /tmp
cp /home/c00954327/slime-run/wheels/sgl-kernel-npu-a3.zip sgl-kernel-npu-a3.zip
echo "1fec018f7842f505cdf13555a0bd948e4f5b6c8b0ef2c6a4dc800d1df8373e97  sgl-kernel-npu-a3.zip" | sha256sum -c -
unzip -o sgl-kernel-npu-a3.zip
pip install torch_memory_saver*.whl
pip install sgl_kernel_npu*.whl attentions*.whl
pip install deep_ep*.whl
cd "$(pip show deep-ep | awk '/^Location:/ {print $2}')"
ln -sf deep_ep/deep_ep_cpp*.so

echo "3a. rebuild only the patched torch-memory-saver wheel"
for a in 1 2 3 4 5; do if [ -d /tmp/sgl-kernel-npu-src ]; then if git -C /tmp/sgl-kernel-npu-src rev-parse -q --verify HEAD; then echo SKIP_CLONE_sgl_kernel_src; git -C /tmp/sgl-kernel-npu-src am --abort 2>/dev/null || true; git -C /tmp/sgl-kernel-npu-src reset --hard; git -C /tmp/sgl-kernel-npu-src clean -fd; break; fi; rm -rf /tmp/sgl-kernel-npu-src; fi; if git clone https://github.com/sgl-project/sgl-kernel-npu.git /tmp/sgl-kernel-npu-src; then break; fi; echo RETRY_CLONE_sgl_kernel_src; sleep 20; done
cd /tmp/sgl-kernel-npu-src
git checkout 9765e27532b8f854717eba1d3fb9a0bb97a0c887
git am "${REPO_ROOT}"/patches/third_party/sgl-kernel-npu/0001-fix-torch-memory-saver-allocation-lifecycle.patch
git am "${REPO_ROOT}"/patches/third_party/sgl-kernel-npu/0002-fix-tms-sglang-cuda-graph-api-and-preload-mode.patch
git am "${REPO_ROOT}"/patches/third_party/sgl-kernel-npu/0003-fix-tms-unaligned-allocations-and-nested-regions.patch
cd contrib/torch_memory_saver/python
python3 setup.py clean --all
python3 setup.py bdist_wheel
pip install --force-reinstall dist/torch_memory_saver*.whl
cd "${DEPS_ROOT}"

echo "4. install mbridge & Megatron-Bridge"
for a in 1 2 3 4 5; do if [ -d /home/c00954327/mbridge ]; then if git -C /home/c00954327/mbridge rev-parse -q --verify HEAD; then echo SKIP_CLONE_mbridge; git -C /home/c00954327/mbridge am --abort 2>/dev/null || true; git -C /home/c00954327/mbridge reset --hard; git -C /home/c00954327/mbridge clean -fd; break; fi; rm -rf /home/c00954327/mbridge; fi; if git clone https://github.com/ISEEKYAN/mbridge.git; then break; fi; echo RETRY_CLONE_mbridge; sleep 20; done
cd mbridge
git checkout 89eb10887887bc74853f89a4de258c0702932a1c
git am "${REPO_ROOT}/patches/third_party/mbridge/0001-fix-device-type.patch"
pip install -e .
cd ..

for a in 1 2 3 4 5; do if [ -d /home/c00954327/Megatron-Bridge ]; then if git -C /home/c00954327/Megatron-Bridge rev-parse -q --verify HEAD; then echo SKIP_CLONE_Megatron_Bridge; git -C /home/c00954327/Megatron-Bridge am --abort 2>/dev/null || true; git -C /home/c00954327/Megatron-Bridge reset --hard; git -C /home/c00954327/Megatron-Bridge clean -fd; break; fi; rm -rf /home/c00954327/Megatron-Bridge; fi; if git clone https://github.com/fzyzcjy/Megatron-Bridge.git; then break; fi; echo RETRY_CLONE_Megatron_Bridge; sleep 20; done
cd Megatron-Bridge
git checkout 35b4ebfc486fb15dcc0273ceea804c3606be948a
git am "${REPO_ROOT}/patches/third_party/megatron-bridge/0001-ascend-megatron-bridge-patch-for-slime-v0.3.2.patch" \
    "${REPO_ROOT}/patches/third_party/megatron-bridge/0002-adapts-to-transformer-5.3.0-for-VL-model.patch" \
    "${REPO_ROOT}/patches/third_party/megatron-bridge/0003-megatron-Bridge-for-Qwen.patch"
cd ..
pip install 'nvidia-modelopt[torch]==0.46.1' --no-build-isolation

for a in 1 2 3 4 5; do if [ -d /home/c00954327/Megatron-LM ]; then if git -C /home/c00954327/Megatron-LM rev-parse -q --verify HEAD; then echo SKIP_CLONE_Megatron_LM; git -C /home/c00954327/Megatron-LM am --abort 2>/dev/null || true; git -C /home/c00954327/Megatron-LM reset --hard; git -C /home/c00954327/Megatron-LM clean -fd; break; fi; rm -rf /home/c00954327/Megatron-LM; fi; if git clone https://github.com/NVIDIA/Megatron-LM.git --recursive; then break; fi; echo RETRY_CLONE_Megatron_LM; sleep 20; done
cd Megatron-LM/
git checkout 4b4acac9a1d28ea6829c8d4f566d75698a21249d
git am "${REPO_ROOT}/patches/third_party/megatron/megatron-npu-v040-rebased.patch" \
    "${REPO_ROOT}/patches/third_party/megatron/0002-ascend-async-checkpoint-worker.patch"
pip install -e .
cd ..

echo "5. install MA&TE"
for a in 1 2 3 4 5; do if [ -d /home/c00954327/MegatronAdaptor ]; then if git -C /home/c00954327/MegatronAdaptor rev-parse -q --verify HEAD; then echo SKIP_CLONE_MegatronAdaptor; git -C /home/c00954327/MegatronAdaptor am --abort 2>/dev/null || true; git -C /home/c00954327/MegatronAdaptor reset --hard; git -C /home/c00954327/MegatronAdaptor clean -fd; break; fi; rm -rf /home/c00954327/MegatronAdaptor; fi; if git clone https://gitcode.com/Ascend/MegatronAdaptor.git; then break; fi; echo RETRY_CLONE_MegatronAdaptor; sleep 20; done
cd MegatronAdaptor/
git checkout eb0e5043438dd753099432bc3b3d8e5916ed1844
git am "${REPO_ROOT}/patches/third_party/megatron-adaptor/0001-async-preload-pickle.patch"
pip install -e .
cd ..

for a in 1 2 3 4 5; do if [ -d /home/c00954327/TransformerEngineNPU ]; then if git -C /home/c00954327/TransformerEngineNPU rev-parse -q --verify HEAD; then echo SKIP_CLONE_TransformerEngineNPU; git -C /home/c00954327/TransformerEngineNPU am --abort 2>/dev/null || true; git -C /home/c00954327/TransformerEngineNPU reset --hard; git -C /home/c00954327/TransformerEngineNPU clean -fd; break; fi; rm -rf /home/c00954327/TransformerEngineNPU; fi; if git clone https://gitcode.com/Ascend/TransformerEngineNPU.git; then break; fi; echo RETRY_CLONE_TransformerEngineNPU; sleep 20; done
cd TransformerEngineNPU/
git checkout 2c5e511a5aa33c1d959519c0bf5e7842973bbd93
pip install -e .
cd ..

echo "6. install triton_ascend"
echo SKIP_TRITON_UNINSTALL_already_3.2.1
echo SKIP_TRITON_REINSTALL_A
echo SKIP_TRITON_REINSTALL_B
echo SKIP_TRITON_REINSTALL_C

echo "7. install slime-ascend"
# Keep the submodule on the pinned upstream main commit and replay the registered
# format-patch series before installing the Python project.
cd "${REPO_ROOT}"
bash build.sh
cd slime/
pip install -e .

echo "8. installation complete"
cd "${REPO_ROOT}"
# Create folder to store logs
mkdir -p logs
